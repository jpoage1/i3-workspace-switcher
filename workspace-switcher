log() {
  priority="$1"; shift
  log.sh "$priority" "$*"
}
build_slide_cache() {
  local index=0
  local cache_content=""

  if [[ ! -f "$WS_CACHE_FILE" ]]; then
    log error "Workspace cache file not found: $WS_CACHE_FILE"
    return 1
  fi

  while IFS= read -r line; do
    name=$(echo "$line" | sed -E 's/^[0-9]+:"?([^"]+)"?$/\1/')
    cache_content+="$index"$'\n'
    index=$(( index + ${#name} + 1 )) # +1 for space
  done < "$WS_CACHE_FILE"

  write_file "$SLIDE_CACHE_FILE"  "$SLIDE_CACHE_FILE_LOCK" "$cache_content"

  # Save hash of the workspace file
  # cat "$cache_content" | awk '{print $1}' > "$SLIDE_CACHE_FILE"
}
generate_slide_cache() {
  local index=0
  local slide_indexes=()

  # Create or truncate the slide cache file
  : > "$SLIDE_CACHE_FILE"

  while IFS= read -r line; do
    # Strip quotes and numbers
    name=$(echo "$line" | sed -E 's/^[0-9]+:"(.*)"$/\1/')
    slide_indexes+=("$index")
    index=$((index + ${#name} + 1)) # +1 for the space between names
  done < "$WS_CACHE_FILE"

  for idx in "${slide_indexes[@]}"; do
    echo "$idx" >> "$SLIDE_CACHE_FILE"
  done
}

validate_workspace_cache() {
  if [[ ! -f "$WS_CACHE_FILE" || ! -f "$SLIDE_CACHE_FILE" || ! -f "$WORKSPACE_HASH_FILE" ]]; then
    log notice "Hash file is missing..."
    return 1
  fi

  local current_hash=$(get_workspace_hash)
  local saved_hash=$(< "$WORKSPACE_HASH_FILE")
  log debug "Current hash: $current_hash; Saved hash: $saved_hash"

  if [[ "$current_hash" != "$saved_hash" ]]; then
    log info "Workspace config changed, running polybar_hook..."
    return 1
  fi

  log debug "No workspace config changes."

  return 0
}


