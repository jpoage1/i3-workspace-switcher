load_workspace_cache() {
  cat "$WS_CACHE_FILE"
}

get_workspaces() {
  if ! is_workspace_cache_valid; then
    rebuild_workspace_cache
    build_slide_cache
    write_file "$WORKSPACE_HASH_FILE" "$WORKSPACE_HASH_FILE_LOCK" "$(get_workspace_hash)"
  fi
  log debug "$WS_CACHE_FILE"
  cat "$WS_CACHE_FILE"
}

get_menu_option() {
  label="$2"
  if [[ -z $MENU_TYPE ]]; then
    if [[ -n $alt_cmd ]]; then
      MENU_TYPE="$alt_cmd"
      log notice "⚠️ Using fallback menu type: $MENU_TYPE"
    else
      log err "❌ No menu type provided, and no fallback available."
      exit 1
    fi
  fi

  if ! command -v ${MENU_TYPE%%_*} &>/dev/null; then
    log err "❌ Menu command '${MENU_TYPE%%_*}' not found on system."
    exit 1
  fi
  echo -e "$WORKSPACES" | $MENU_TYPE "$label"
}
get_selected_workspace() {
  label="$1"
  # Get selected workspace
  selected_workspace=$(get_menu_option "$WORKSPACES" "$label")
  if [[ -z "$selected_workspace" ]]; then
    log info "No workspace selected"
    exit 1
  fi
  log info "Selected workspace: $selected_workspace"
  export SELECTED_WORKSPACE=$selected_workspace
}
switch_workspace() {

  # Get the workspace number
  workspace_number=$(echo "$SELECTED_WORKSPACE" | awk '{print $1}')

  # Get the workspace name
  workspace_name=$(echo "$SELECTED_WORKSPACE" | awk '{print $2}')

  # Switch to the workspace
  if [[ -z "$workspace_number" ]]; then
    log err "No workspace number provided, instead received: $SELECTED_WORKSPACE"
    exit 1
  fi
  if [[ -z "$workspace_name" ]]; then
    label=$workspace_number
  else
    label="$workspace_number:\"$workspace_name\""
  fi
  log info "Switching to workspace: $label"
  i3-msg workspace "$label"
}
move_window() {
    # Get the focused window's ID in i3
    focused_window_id=$(i3-msg -t get_tree | jq '.. | select(.focused? == true) | .id')
    log info "Moving window id: $focused_window_id"

    selected_window_num=$(i3-msg -t get_tree | jq --argjson id "$focused_window_id" 'recurse(.nodes[]?, .floating_nodes[]?) | select(.id == $id) | .window')
    log info "With window num: $selected_window_num"

    # Focus the selected workspace and move the focused window to it
    i3-msg [id=$selected_window_num] move window to workspace "$SELECTED_WORKSPACE"
}
shift_workspace() {
    move_window
    switch_workspace
}
cleanup() {
  [[ -f "$LOCKFILE" && "$(cat "$LOCKFILE")" == "$$" ]] && rm -f "$LOCKFILE"
  exit
}
check_lockfile() {
  local lockfile="$1"
  if [[ -f "$lockfile" ]]; then
    local pid=$(cat "$lockfile")
    if kill -0 "$pid" 2>/dev/null; then
      log error "Another instance is running with PID: $pid"
      exit 1
    else
      rm -f "$lockfile"
    fi
  fi

  lockfile="$1"

if [[ -f "$lockfile" ]]; then
  pid=$(<"$lockfile")  # Faster than cat
  if kill -0 "$pid" 2>/dev/null; then
    echo "Another instance is running with PID: $pid" >&2
    exit 1
  else
    rm -f "$lockfile"
  fi
fi
  # Create a new lockfile
  echo $$ > "$lockfile"
  chmod 600 "$lockfile"
}
start_ipc_listener() {
  # Only one listener should be running
  check_lockfile "$IPC_LOCKFILE"

  log info "Starting background process for workspace-switcher"

  # Clean up on kill/exit
  trap cleanup EXIT INT TERM

  # Start IPC listener in background
  i3-msg -t subscribe '[ "workspace" ]' | while read -r _; do
    polybar_hook
  done &
  #polybar_hook
  exit 0
}

polybar_hook () {
  polybar-msg action "#$MODULE_NAME.hook.$HOOK_INDEX"
}

workspace_rehash() {
  new_hash=$(get_workspace_hash)
  old_hash=$(cat "$WORKSPACE_HASH_FILE" 2>/dev/null)

  if [[ "$new_hash" != "$old_hash" ]]; then
    log info "Workspace config changed, running polybar_hook..."
    log debug "$WORKSPACE_HASH_FILE" "$WORKSPACE_HASH_FILE_LOCK" "$new_hash"
    write_file "$WORKSPACE_HASH_FILE" "$WORKSPACE_HASH_FILE_LOCK" "$new_hash"
    # echo "$new_hash" > "$WORKSPACE_HASH_FILE"

    polybar_hook
  else
    log debug "No workspace config changes."
  fi
}

is_polybar_running() {
  pgrep -x polybar >/dev/null
}
main() {
  config=""
  ALT_CMD=""
  positional=()
  umask 077 # Set umask to 077 to ensure all files are created with restrictive permissions
  mkdir -p "$WS_CACHE_DIR"
  if [[ "$1" == "--launch" ]]; then
      log info "Launching the workspace-switcher bar"
      polybar_hook
      exit 0
  elif [[ "$1" = "--startup" ]]; then
    log info "Starting Workspace Switcher"
    start_ipc_listener
    return 0
  fi

  # Parse arguments
  for arg in "$@"; do
    case "$arg" in
      -h|--help)
        echo "Usage: $0 [--config=PATH] [-rofi|-dmenu] [switch|move|list]" >&2
        exit 0
        ;;
      --config=*)
        CONFIG_PATH="${arg#*=}"
        ;;
      -rofi)
        mode="menu"
        MENU_TYPE="rofi_menu"
        ;;
      -dmenu)
        mode="menu"
        MENU_TYPE="dmenu_menu"
        ;;
      ws=*)
        ws="${arg#*=}"
        number="${ws%%|*}"
        name="${ws#*|}"
        export SELECTED_WORKSPACE="$number:\"$name\""
        ;;
      scroll=*)
        mode="scroll"
        direction="${arg#*=}"
        ;;
      slide=*)
        mode="slide"
        direction="${arg#*=}"
        ;;
      alt=*)
        ALT_CMD="${arg#*=}"
        ;;
      *)
        positional+=("$arg")
        ;;
    esac
  done

  command=${positional[0]}

  log debug "mode: $mode; direction: $direction"
  case "$mode" in
    scroll)
      if [[ "$direction" = "up" || "$direction" = "down" ]]; then
        scroll "$direction"
      fi
      exit 0
      ;;
    slide)
      if [[ "$direction" = "left" || "$direction" = "right" ]]; then
        slide "$direction"
        log info "slide $direction"
      fi
      exit 0
      ;;
  esac

  # Access:
  # $config    → path to config file
  # $mode      → 'rofi' or 'dmenu'
  # $alt_cmd   → alternate fallback command
  # ${positional[0]} → optional command (e.g., "switch", "reload", etc.)

  # Debug output
  # echo "Config: $config" >&2
  # echo "Menu: $MENU_TYPE" >&2
  # echo "Alt: $ALT_CMD" >&2
  # echo "Command: $command" >&2

  # Possible config paths (in search order)
  POSSIBLE_PATHS=(
    "$CONFIG_PATH"
    "$I3_CONFIG_PATH"
    "$XDG_CONFIG_HOME/i3/config"
    "$HOME/.config/i3/config"
    "$HOME/.i3/config"
    "/etc/i3/config"
  )

  # Get config content in memory
  config_from_i3=$(i3-msg -t get_config)

  export WORKSPACES=$(get_workspaces)
  read -ra WORKSPACE_ARRAY <<< "$WORKSPACES"

  case "$command" in
    --startup)
      start_ipc_listener
      # workspace_bar
      ;;
    --launch)
      echo "test"
      #polybar_hook
      exit 0
      # workspace_bar
      ;;
    bar)
      # log debug "Launching (or refreshing) Workspace Bar"
      scrollable_workspace_bar
      ;;
    list)
      log info "List workspaces"
      echo "$WORKSPACES"
      ;;
    switch)
      log info "Switch workspaces"
      [[ -n "$SELECTED_WORKSPACE" ]] || get_selected_workspace "Go to workspace"
      switch_workspace
      ;;
    shift)
      log info "Shift workspaces"
      [[ -n "$SELECTED_WORKSPACE" ]] || get_selected_workspace "Shift to workspace"
      shift_workspace
      ;;
    move)
      log info "Move Workspaces"
      [[ -n "$SELECTED_WORKSPACE" ]] || get_selected_workspace "Move window to workspace"
      move_window
      ;;
    *)
      echo "Invalid command or no command provided" >&2
      ;;
  esac
}
main "$@" || exit 1
exit 0
