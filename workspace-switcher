scroll() {
  direction="$1"

  # Load current index
  if [[ -f $INDEX_CACHE_FILE ]]; then
      index=$(<"$INDEX_CACHE_FILE")
  else
      index=0
  fi
  # Update index
  count=${#WORKSPACE_ARRAY[@]}
  if [[ "$direction" == "up" ]]; then
    log debug "Scroll up"
    ((index++))
  elif [[ "$direction" == "down" ]]; then
   if [ "$index" -lt 1 ]; then
      log debug "Scroll down"
      index=0
    else
      ((index--))
    fi
  fi
  # Save new index
  write_file "$INDEX_CACHE_FILE" "$SCROLL_INDEX_CACHE_FILE" "$index"
  # echo "$index" > "$INDEX_CACHE_FILE"
}
scrollable_workspace_bar() {

  current_index=0

  # Load saved index
  if [[ -f $INDEX_CACHE_FILE ]]; then
      current_index=$(<"$INDEX_CACHE_FILE")
  fi

  export WORKSPACE_ARRAY
  IFS=$'\n' read -r -d '' -a WORKSPACE_ARRAY <<< "$WORKSPACES"

  # Clamp index
  [[ $current_index -lt 0 ]] && current_index=0
  max_index=$((${#WORKSPACE_ARRAY[@]} - NUM_WORKSPACES))
  [[ $current_index -gt $max_index ]] && current_index=$max_index

  current=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused==true).name')
  echo -n "%{u#00ff00 +u}$(workspace_item "$current")%{u-} "
  echo -n "%{A1:workspace-switcher scroll=down :}    ⬅️  %{A}"
  echo -n "     %{A1:workspace-switcher scroll=up:}➡️    %{A} "
  # Slide left or right
  # echo -n "%{A4:workspace-switcher slide=left :}%{A5:workspace-switcher slide=right :}"
  echo -n "%{A4:workspace-switcher scroll=up :}%{A5:workspace-switcher scroll=down :}"

  log debug "${WORKSPACE_ARRAY[@]}"
  for ((i = current_index; i < current_index + $NUM_WORKSPACES && i < ${#WORKSPACE_ARRAY[@]}; i++)); do
    ws="${WORKSPACE_ARRAY[i]}"
    item=$(workspace_item "$ws")
    if [[ "$ws" != "$current" ]]; then
      echo -n "$item "
    else
      ((NUM_WORKSPACES++))
    #   echo -n "%{u#00ff00 +u}$item%{u-} "
    fi
  done
  echo -n "%{A}%{A}"
  echo -n "%{A1:workspace-switcher scroll=up:}    ➡️    %{A} "
  echo
}
get_workspace_hash() {
  # get_workspaces | sha256sum | awk '{print $1}'
  workspace_hash=$(cat "$WS_CACHE_FILE" "$SLIDE_CACHE_FILE" | sha256sum | awk '{print $1}')
  echo "$workspace_hash"
}


slidable_workspace_bar() {
  local current_index=0
  local current_slide_index=0

  # Load saved index
  if [[ -f $INDEX_CACHE_FILE ]]; then
    current_index=$(<"$INDEX_CACHE_FILE")
  fi

  # Load beginning slide indexes
  if [[ -f $SLIDE_CACHE_FILE ]]; then
    mapfile -t SLIDE_INDEXES < "$SLIDE_CACHE_FILE"
  fi

  export WORKSPACE_ARRAY
  IFS=$'\n' read -r -d '' -a WORKSPACE_ARRAY <<< "$WORKSPACES"

  # Build the full output string
  local output=""
  for ws in "${WORKSPACE_ARRAY[@]}"; do
    output+=$(workspace_item "$ws")
    output+=" "
  done
  output="${output% }" # Remove trailing space

  local output_length=${#output}
  local slice_start=${SLIDE_INDEXES[$current_index]:-0}
  local slice_end=$output_length

  # Adjust slice_end based on desired window size
  if (( output_length > MAX_BAR_SIZE )); then
    slice_end=$((slice_start + MAX_BAR_SIZE))
    [[ $slice_end -gt $output_length ]] && slice_end=$output_length
  elif (( output_length < MIN_BAR_SIZE )); then
    slice_end=$((slice_start + output_length))
  fi

  local visible_output="${output:slice_start:slice_end-slice_start}"

  current=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused==true).name')

  # Display the bar
  echo -n "%{u#00ff00 +u}$(workspace_item "$current")%{u-} "
  echo -n "%{A1:workspace-switcher scroll=down :}    ⬅️  %{A}"
  echo -n "     %{A1:workspace-switcher scroll=up:}➡️    %{A} "
  echo -n "%{A4:workspace-switcher scroll=up :}%{A5:workspace-switcher scroll=down :}"

  echo -n "$visible_output"

  echo -n "%{A}%{A}"
  echo -n "%{A1:workspace-switcher scroll=up:}    ➡️    %{A} "
  echo
}


workspace_item() {
    ws="$1"
    name="${ws#*:}"
    number="${ws%%:*}"
    name=${name//\"/}
    [[ "$name" == "$number" ]] && label="${name:-$number}" || label="$number $name"
    cmd_prefix="workspace-switcher ws=\"$number|$name\""
    echo -n "%{A1:$cmd_prefix switch:}%{A3:$cmd_prefix move:}%{A2:$cmd_prefix shift:}$label%{A}%{A}%{A} "

}
workspace_item() {
    ws="$1"
    name="${ws#*:}"
    number="${ws%%:*}"
    name=${name//\"/}

    # Set max length for workspace name
    max_length=20  # Limit the name to 20 characters

    # Truncate if the name is too long
    if [[ ${#name} -gt $max_length ]]; then
        name="${name:0:$max_length}..."
    fi

    # Set the label to be number + (possibly truncated) name
    [[ "$name" == "$number" ]] && label="${name:-$number}" || label="$number $name"

    cmd_prefix="workspace-switcher ws=\"$number|$name\""
    echo -n "%{A1:$cmd_prefix switch:}%{A3:$cmd_prefix move:}%{A2:$cmd_prefix shift:}$label%{A}%{A}%{A} "
}

find_workspace_config() {
  # Try to find a match
  for path in "${valid_paths[@]}"; do
    file_content=$(<"$path")
    if [[ "$file_content" == "$config_from_i3" ]]; then
      log debug "✅ i3 is using this config file: $path"
      export WORKSPACE_CONFIG="$path"
    fi
  done
  if [[ -z $WORKSPACE_CONFIG ]]; then
      log warn <<EOF
  ❌ No config file on disk matches the one loaded in memory.
  If you are using a config from a non-standard location, ensure
  you are using absolute paths for resolving includes in your i3-config.
  Alternatively, pass the --config=/path/to/config if you are using includes.
EOF
  fi
}
parse_workspace_lines() {
  workspace_lines="$1"
  # Rewrite each line, resolving variables
  while read -r line; do
    ws_var=$(echo "$line" | awk '{print $2}')
    mon_var=$(echo "$line" | awk '{print $4}')

    ws_val="${vars[$ws_var]}"
    mon_val="${vars[$mon_var]}"

    if [[ -n "$ws_val" && -n "$mon_val" ]]; then
      echo "workspace \"$ws_val\" output $mon_val"
    else
      # Leave the line untouched if the variable isn't found
      echo "$line"
    fi
  done <<< "$workspace_lines"
}
resolve_includes() {
  local input="$1"
  local base_dir="$2"
  local output=""

  # Declare an associative array to track processed files
  declare -gA processed_files

  while IFS= read -r line; do
    if [[ "$line" =~ ^include[[:space:]]+(.+) ]]; then
      include_path=$(eval echo "${BASH_REMATCH[1]}")
      # Resolve relative paths against the base directory
      if [[ "$include_path" != /* ]]; then
        include_path="$base_dir/$include_path"
      fi
      if [[ -f "$include_path" ]]; then
        include_path=$(realpath "$include_path")  # Normalize path
        mtime=$(stat -c %Y "$include_path")
        # log info "$include_path:$mtime"
        # # write_file "$TIMESTAMP_FILE" "$TIMESTAMP_FILE_LOCK" "$include_path:$mtime"
        # echo "$include_path:$mtime" >> "$TIMESTAMP_FILE"
        # Check if the include_path is already in the TIMESTAMP_FILE
        # Skip processing if the file has already been processed
        if [[ -n "${processed_files[$include_path]}" ]]; then
          log debug "Skipping already processed file: $include_path"
          continue
        fi

        # Mark the file as processed
        processed_files["$include_path"]=1

        log debug "Checking if $include_path:$mtime exists in $TIMESTAMP_FILE"
        if ! grep -q "^$include_path:$mtime$" "$TIMESTAMP_FILE"; then
          log debug "Entry not found. Writing $include_path:$mtime to $TIMESTAMP_FILE"
          echo "$include_path:$mtime" >> "$TIMESTAMP_FILE"
        else
          log debug "Entry already exists: $include_path:$mtime"
        fi
        included_content=$(<"$include_path")
        included_base_dir=$(dirname "$include_path")
        included_resolved=$(resolve_includes "$included_content" "$included_base_dir")
        output+="$included_resolved"$'\n'
      else
        log warn "included file '$include_path' not found."
      fi
    else
      output+="$line"$'\n'
    fi
  done <<< "$input"

  echo "$output"
}
is_workspace_cache_valid() {
  local valid_cache=true

  if ! validate_workspace_cache; then
    log warn "Workspace cache hash invalid"
    valid_cache=false
  fi

  if [[ -f "$WS_CACHE_FILE" && -f "$TIMESTAMP_FILE" ]]; then
    while IFS= read -r line; do
      file=$(cut -d':' -f1 <<< "$line")
      old_mtime=$(cut -d':' -f2 <<< "$line")
      new_mtime=$(stat -c %Y "$file" 2>/dev/null || echo 0)
      if [[ "$old_mtime" != "$new_mtime" ]]; then
        log info "Workspace config file changed: $file"
        valid_cache=false
        break
      fi
    done < "$TIMESTAMP_FILE"
  else
    log info "No cache or timestamp file found..."
    valid_cache=false
  fi

  if [[ "$FORCE_CACHE_REBUILD" = true ]]; then
    log info "FORCE_CACHE_REBUILD set, invalidating cache"
    valid_cache=false
  fi
  [[ "$valid_cache" == true ]]
}

rebuild_workspace_cache() {
  log info "Rebuilding workspace cache..."

  valid_paths=()
  [[ -f "$CONFIG_PATH" ]] && valid_paths+=("$CONFIG_PATH")
  for path in "${POSSIBLE_PATHS[@]}"; do
    [[ -n "$path" && -f "$path" ]] && valid_paths+=("$path")
  done

  find_workspace_config

  base_dir=$(dirname "$WORKSPACE_CONFIG")
  flattened_config=$(resolve_includes "$config_from_i3" "$base_dir")

  declare -A vars
  while read -r line; do
    var_name=$(echo "$line" | awk '{print $2}')
    var_value=$(echo "$line" | cut -d' ' -f3-)
    vars["$var_name"]="$var_value"
  done < <(echo "$flattened_config" | grep -E '^set \$[A-Za-z_][A-Za-z0-9_]* .+')

  workspace_lines=$(echo "$flattened_config" | grep -E '^workspace \$[A-Za-z_][A-Za-z0-9_]* output \$[A-Za-z_][A-Za-z0-9_]*')

  workspace_names=$(echo "$(parse_workspace_lines "$workspace_lines")" | awk '{print $2}' | sed 's/^"//; s/"$//')

  write_file "$WS_CACHE_FILE" "$WS_CACHE_FILE_LOCK" "$workspace_names"

  # build_slide_cache
}

