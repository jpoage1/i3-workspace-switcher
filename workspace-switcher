rotate_log() {
    # Check if the log file exceeds the maximum size
    if [ "$(stat -c%s "$LOGFILE")" -gt "$MAX_LOG_SIZE" ]; then
        local date=$(get_date)
        # Archive the current log file by renaming it
        mv "$LOGFILE" "$LOGFILE-$date.old"

        # Clear the contents of the log file (truncate)
        : > "$LOGFILE"

        # Optionally, log the rotation event with the current date
        log debug "$LOGFILE" "$LOGFILE_LOCK" "[$date] Log file rotated and archived"
        write_file  "$LOGFILE" "$LOGFILE_LOCK" "[$date] Log file rotated and archived"
        # echo "[$date] Log file rotated and archived" >> "$LOGFILE"

    fi
}

