# echo "$all_workspaces"
exit
unnamed_workspaces=$(i3-msg -t get_workspaces | jq -r '.[] | select(.name | test("^\\d+$")) | .name')
unnamed_workspaces=$(for ws in "$unnamed_workspaces"; do echo "${ws} Active"; done)
unnamed_workspaces=$(for ws in $unnamed_workspaces; do echo "${ws} Active"; done)
workspaces="$named_workspaces
$unnamed_workspaces"



mapfile -t lines <<< "$workspaces"

expected=1
index=0
new_list=()

while [ $expected -le $total_workspaces ]; do
    if [ $index -lt ${#lines[@]} ]; then
        line="${lines[$index]}"
        line_number=$(echo "$line" | awk '{print $1}')

        if [[ "$line_number" =~ ^[0-9]+$ && "$line_number" -eq "$expected" ]]; then
            output="$expected ${line#* }"
            new_list+=("$output")
            echo "$output"
            ((index++))
        else
            new_list+=("$expected")
            echo "$expected"
        fi
    else
        new_list+=("$expected")
        echo "$expected"
    fi
    ((expected++))
done